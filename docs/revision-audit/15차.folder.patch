+    for source, name in [(previous, 'previous.apk'), (current, 'current.apk'), (tests, 'tests.apk')]:
+        target = work / name
+        shutil.copyfile(source, target)
+        if sha(source) != sha(target):
+            raise SystemExit('설치용 ASCII 복사본 해시 불일치')
